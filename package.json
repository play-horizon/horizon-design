{
	"name": "horizon-design",
	"version": "0.0.23",
	"keywords": [
		"svelte"
	],
	"homepage": "https://play-horizon.github.io/horizon-design",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/play-horizon/horizon-design"
	},
	"scripts": {
		"tokens": "node scripts/tokens/generate.ts",
		"dev": "node scripts/tokens/generate.ts && vite dev",
		"build": "node scripts/tokens/generate.ts && vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "node scripts/tokens/generate.ts && (svelte-kit sync || echo '')",
		"prepack": "node scripts/tokens/generate.ts && svelte-kit sync && svelte-package && publint",
		"check": "node scripts/tokens/generate.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node scripts/tokens/generate.ts && vitest run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"svelte": "./dist/editor/index.js"
		},
		"./tokens": {
			"types": "./dist/generated/tokens.d.ts",
			"default": "./dist/generated/tokens.js"
		},
		"./horizon-design.css": "./dist/horizon-design.css"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify-json/mingcute": "^1.2.10",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^24.19.2",
		"colorjs.io": "^0.7.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.25.1",
		"@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
		"@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
		"clsx": "^2.1.1",
		"fuzzysort": "^4.0.2",
		"horizon-layout": "^1.0.3",
		"tailwind-merge": "^3.7.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.2.0",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.18.0"
}
